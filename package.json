{
  "name": "workbuddy-dual-edition-manager",
  "version": "0.6.10",
  "private": true,
  "description": "Windows 用户级管理器：WorkBuddy 国内版与 WorkBuddy AI 国际版共存（当前为只读检测模式）",
  "author": "workbuddy-dual-edition",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "vitest",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "scan:report": "npm run build && node scripts/scan-report.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:portable": "npm run build && node scripts/pack-portable.mjs",
    "verify:package": "node scripts/verify-package.mjs release-portable/win-unpacked"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
